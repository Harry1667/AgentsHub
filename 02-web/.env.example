# ===== 資料庫 (MySQL) =====
# 格式：mysql://使用者:密碼@主機:3306/資料庫名
DATABASE_URL=

# ===== Session 加密金鑰 =====
# 產生方式：openssl rand -hex 32
SESSION_SECRET=

# ===== 管理員登入帳密 =====
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ===== 註冊邀請碼（登入頁「新增用戶」需填此碼；留空則關閉註冊） =====
REGISTER_CODE=

# ===== Proxy AI 服務 =====
PROXY_TOKEN=
PROXY_BASE_URL=https://clip.twloop.com
PROXY_PROJECT=agent-hub
